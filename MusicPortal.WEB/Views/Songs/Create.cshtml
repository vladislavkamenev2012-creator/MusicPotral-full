@model MusicPortal.WEB.Models.CreateSongViewModel

@{
    ViewData["Title"] = Localizer["AddSong"];
}

<h2>@Localizer["AddSong"]</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">@Localizer["SongTitle"]</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Artist" class="form-label">@Localizer["Artist"]</label>
                <input asp-for="Artist" class="form-control" />
                <span asp-validation-for="Artist" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GenreId" class="form-label">@Localizer["Genre"]</label>
                <select asp-for="GenreId" class="form-select">
                    <option value="">@Localizer["SelectGenre"]</option>
                    @if (ViewBag.Genres != null)
                    {
                        foreach (var g in (IEnumerable<MusicPortal.BLL.DTOs.GenreDTO>)ViewBag.Genres)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AudioFile" class="form-label">@Localizer["AudioFile"]</label>
                <input asp-for="AudioFile" type="file" accept="audio/*" class="form-control" />
                <span asp-validation-for="AudioFile" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">@Localizer["Add"]</button>
            <a asp-action="Index" class="btn btn-secondary">@Localizer["Back"]</a>
        </form>
    </div>
</div>
