@{
    ViewData["Title"] = Localizer["Admin"];
    var users = ViewBag.Users as IEnumerable<MusicPortal.BLL.DTOs.UserDTO>;
    var genres = ViewBag.Genres as IEnumerable<MusicPortal.BLL.DTOs.GenreDTO>;
}

<h2>⚙️ @Localizer["Admin"]</h2>
<hr />

<div class="row mt-4">
    <div class="col-md-7">
        <h4>@Localizer["UsersAndRequests"]</h4>
        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Localizer["Username"]</th>
                    <th>@Localizer["Role"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (users != null)
                {
                    foreach (var u in users)
                    {
                        <tr>
                            <td>@u.Username</td>
                            <td>@u.Role</td>
                            <td>
                                @if (u.IsApproved)
                                {
                                    <span class="badge bg-success">@Localizer["Active"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@Localizer["PendingApproval"]</span>
                                }
                            </td>
                            <td>
                                @if (!u.IsApproved)
                                {
                                    <form asp-action="ApproveUser" asp-route-id="@u.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-success btn-sm">@Localizer["Approve"]</button>
                                    </form>
                                }
                                <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('@Localizer["ConfirmDeleteUser"]');">
                                    <button type="submit" class="btn btn-danger btn-sm">@Localizer["Delete"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-5">
        <h4>@Localizer["GenreManagement"]</h4>
        <form asp-action="AddGenre" method="post" class="input-group mb-3">
            <input type="text" name="name" class="form-control" placeholder="@Localizer["NewGenre"]" required />
            <button type="submit" class="btn btn-primary">@Localizer["AddGenreBtn"]</button>
        </form>

        <ul class="list-group">
            @if (genres != null)
            {
                foreach (var g in genres)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @g.Name
                        <form asp-action="DeleteGenre" asp-route-id="@g.Id" method="post" onsubmit="return confirm('@Localizer["ConfirmDeleteGenre"]');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">🗑️</button>
                        </form>
                    </li>
                }
            }
        </ul>
    </div>
</div>
