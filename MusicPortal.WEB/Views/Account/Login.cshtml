@model MusicPortal.WEB.Models.LoginViewModel

@{
    ViewData["Title"] = Localizer["Login"];
}

<h2>@Localizer["LoginHeading"]</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">@Localizer["Username"]</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">@Localizer["Password"]</label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">@Localizer["SignIn"]</button>
        </form>
    </div>
</div>
